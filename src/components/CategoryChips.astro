---
import { url, type Category } from '../lib/catalog';

interface Props {
  categories: Category[];
  current?: string;
}

const { categories, current } = Astro.props;
---
<nav class="chips" aria-label="Категории">
  <a class="chip" href={url('catalog/')} aria-current={current ? undefined : 'page'}>Все</a>
  {categories.map((c) => (
    <a class="chip" href={url(`catalog/${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>
      {c.data.name}
    </a>
  ))}
</nav>
