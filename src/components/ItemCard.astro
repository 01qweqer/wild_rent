---
import { Image } from 'astro:assets';
import { SITE } from '../site.config';
import { formatPrice, url, type Item } from '../lib/catalog';

interface Props {
  item: Item;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
const { name, price, photos, available, includes } = item.data;
---
<article class="card">
  <a class="card-link" href={url(`item/${item.id}/`)}>
    <div class="card-photo">
      <Image
        src={photos[0]}
        alt={name}
        widths={[320, 480, 640]}
        sizes="(min-width: 1080px) 280px, (min-width: 768px) 30vw, 46vw"
        loading={eager ? 'eager' : 'lazy'}
      />
      {!available && <span class="badge card-badge">Сейчас в аренде</span>}
      {includes.length > 0 && <span class="card-set">Набор</span>}
    </div>
    <div class="card-body">
      <h3 class="card-title">{name}</h3>
      <p class="card-price"><strong>{formatPrice(price)}</strong> <span class="muted">/ {SITE.priceUnit}</span></p>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    display: flex;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
  }

  .card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }

  .card-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card-link:hover .card-photo :global(img) {
    transform: scale(1.03);
  }

  .card-photo {
    overflow: hidden;
  }

  .card-badge {
    position: absolute;
    left: 8px;
    top: 8px;
  }

  .card-set {
    position: absolute;
    right: 8px;
    top: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--brand);
    color: var(--brand-ink);
  }

  .card-body {
    padding: 10px 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-price {
    margin: auto 0 0;
    font-size: 0.95rem;
  }

  .card-price strong {
    font-size: 1.05rem;
  }

  @media (min-width: 768px) {
    .card-body {
      padding: 14px 16px 18px;
    }

    .card-title {
      font-size: 1.02rem;
    }
  }
</style>
